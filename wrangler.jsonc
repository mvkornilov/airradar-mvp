{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airradar-live",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
